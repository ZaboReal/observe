# Copy to .env.local. Keys come from the console's site setup page.

# Publishable key (pk_<site>_<16 hex>): goes in the page.
NEXT_PUBLIC_OBSERVE_KEY=pk_demo_0000000000000000

# Secret key (sk_<site>_<32 hex>): server only, for observe.check().
OBSERVE_SECRET_KEY=sk_demo_00000000000000000000000000000000

# Console base URL. Defaults to the hosted console; here, the local one (pnpm dev:console).
OBSERVE_URL=http://localhost:3100
