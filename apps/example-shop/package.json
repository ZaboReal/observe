{
  "name": "@observe/example-shop",
  "version": "0.1.0",
  "private": true,
  "description": "Acme Invoices: a minimal Next.js app with Observe installed through @observe/next.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @observe/next build && next dev --port 3300",
    "build": "pnpm --filter @observe/next build && next build",
    "start": "next start --port 3300",
    "typecheck": "pnpm --filter @observe/next build && tsc --noEmit"
  },
  "dependencies": {
    "@observe/next": "workspace:*",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
