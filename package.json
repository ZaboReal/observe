{
  "name": "observe",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:console": "pnpm --filter @observe/console dev",
    "dev:sensor": "pnpm --filter @observe/sensor dev",
    "check": "pnpm --filter @observe/check start",
    "check:report": "pnpm --filter @observe/check report"
  }
}
