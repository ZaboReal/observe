{
  "name": "@observe/sensor",
  "version": "0.2.3",
  "description": "Browser sensor that detects AI agents driving a logged-in web session and names the product driving it.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "happy-dom": "^18.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
